data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/reference/*
!data/reference/.gitkeep
data/rejected/*
!data/rejected/.gitkeep
data/quality/*
!data/quality/.gitkeep
*.csv
*.parquet
*.jsonl
*.geojson

