# GeoPulse Environment Configuration Template
# Copy this file to .env and populate with your credentials

# Snowflake Connection Configuration
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=GEOPULSE_DB
SNOWFLAKE_WAREHOUSE=GEOPULSE_WH
SNOWFLAKE_SCHEMA_RAW=RAW
SNOWFLAKE_SCHEMA_STAGING=STAGING
SNOWFLAKE_SCHEMA_PROCESSED=PROCESSED
SNOWFLAKE_SCHEMA_ANALYTICS=ANALYTICS
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Environment
APP_ENV=development
LOG_LEVEL=INFO
